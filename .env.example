# Database Configuration (PostgreSQL/Neon)
# Use Neon PostgreSQL for production or local PostgreSQL for development
DATABASE_URL=postgresql://neondb_owner:npg_8xHhNa3djgCD@ep-rough-term-ahyldri0-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# For local development with Docker Compose:
# DATABASE_URL=postgresql://chat_user:chat_password@localhost:5432/chat_ui
DATABASE_DB_NAME=chat_ui

# OpenAI-Compatible API Configuration
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=your_api_key_here
USE_USER_TOKEN=false
AUTOMATIC_LOGIN=false

# Public App Configuration
PUBLIC_APP_NAME=ChatUI
PUBLIC_APP_ASSETS=chatui
PUBLIC_APP_DESCRIPTION=Making the community's best AI chat models available to everyone.
PUBLIC_SMOOTH_UPDATES=false
PUBLIC_ORIGIN=
PUBLIC_SHARE_PREFIX=
PUBLIC_GOOGLE_ANALYTICS_ID=
PUBLIC_PLAUSIBLE_SCRIPT_URL=
PUBLIC_APPLE_APP_ID=

# Task Model Configuration
# Optional: set to the model id/name from the `${OPENAI_BASE_URL}/models` list
TASK_MODEL=

# LLM Router Configuration (Optional)
LLM_ROUTER_ARCH_BASE_URL=
LLM_ROUTER_ROUTES_PATH=
LLM_ROUTER_ARCH_MODEL=
LLM_ROUTER_OTHER_ROUTE=casual_conversation
LLM_ROUTER_FALLBACK_MODEL=
LLM_ROUTER_ARCH_TIMEOUT_MS=10000
LLM_ROUTER_MAX_ASSISTANT_LENGTH=500
LLM_ROUTER_MAX_PREV_USER_LENGTH=400
LLM_ROUTER_ENABLE_MULTIMODAL=
LLM_ROUTER_MULTIMODAL_MODEL=
LLM_ROUTER_ENABLE_TOOLS=
LLM_ROUTER_TOOLS_MODEL=
PUBLIC_LLM_ROUTER_DISPLAY_NAME=Omni
PUBLIC_LLM_ROUTER_LOGO_URL=
PUBLIC_LLM_ROUTER_ALIAS_ID=omni

# Authentication Configuration
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPES=openid profile inference-api read-mcp
OPENID_PROVIDER_URL=https://huggingface.co
OPENID_NAME_CLAIM=name
OPENID_TOLERANCE=
OPENID_RESOURCE=

# Allowed Users (Optional)
ALLOWED_USER_EMAILS=[]
ALLOWED_USER_DOMAINS=[]
ALTERNATIVE_REDIRECT_URLS=[]

# Cookies Configuration
COOKIE_NAME=hf-chat
COUPLE_SESSION_WITH_COOKIE_NAME=
COOKIE_SAMESITE=
COOKIE_SECURE=
TRUSTED_EMAIL_HEADER=

# Admin Configuration
ADMIN_CLI_LOGIN=true
ADMIN_TOKEN=
ADMIN_API_SECRET=

# Feature Flags
LLM_SUMMARIZATION=true
ALLOW_IFRAME=true
ENABLE_DATA_EXPORT=true
ENABLE_CONFIG_MANAGER=true

# MCP Servers Configuration
MCP_SERVERS=
MCP_FORWARD_HF_USER_TOKEN=

# Usage Limits
USAGE_LIMITS={}

# HuggingFace Specific
HF_ORG_ADMIN=
HF_ORG_EARLY_ACCESS=
WEBHOOK_URL_REPORT_ASSISTANT=

# Metrics Configuration
METRICS_ENABLED=false
METRICS_PORT=5565
LOG_LEVEL=info

# Parquet Export (Optional)
PARQUET_EXPORT_DATASET=
PARQUET_EXPORT_HF_TOKEN=

# Docker Build Variables
APP_BASE=
BODY_SIZE_LIMIT=15728640
PUBLIC_COMMIT_SHA=

# Local PostgreSQL Configuration (for Docker Compose)
LOCAL_POSTGRES_PORT=5432
POSTGRES_DB=chat_ui
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password

# Messaging Agents Configuration (Optional)
# Add your platform-specific tokens here

# Telegram
TELEGRAM_BOT_TOKEN=

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# WhatsApp
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=

# Legacy Parameters (Deprecated)
ALLOW_INSECURE_COOKIES=false
PARQUET_EXPORT_SECRET=
RATE_LIMIT=
